# Kopiraj ovaj fajl u .env i popuni pravu vrednost:
#   cp .env.example .env
#
# Lokalno (Postgres na tvom računaru):
# DATABASE_URL=postgresql://localhost/izbori
#
# Neon (produkcija) — koristi POOLED connection string iz Neon dashboarda,
# prepoznaješ ga po "-pooler" u hostname-u:
# DATABASE_URL=postgresql://user:password@ep-xxxxx-pooler.eu-central-1.aws.neon.tech/izbori?sslmode=require

DATABASE_URL=postgresql://localhost/izbori
